{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values of the Vanishly chart",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespaceOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "",
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "updateStrategy": {
      "type": "object"
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "deploymentLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "deploymentAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "BASE_URL": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^https?://[^/\\s]+(/\\S*)?$"
            }
          ]
        },
        "HOST": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^[\\w.:-]+$"
            }
          ]
        },
        "PORT": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "TRUST_PROXY": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "HSTS": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^$|^(?i:1|0|true|false|yes|no|on|off)$"
            }
          ]
        },
        "ACCESS_LOG": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^$|^(?i:1|0|true|false|yes|no|on|off)$"
            }
          ]
        },
        "REDIS_PREFIX": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^[\\w:.-]{1,64}$"
            }
          ]
        },
        "REDIS_TLS_CA_FILE": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^/\\S*$"
            }
          ]
        },
        "TEMPLATE": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^[a-z0-9_-]{1,32}$"
            }
          ]
        },
        "DEFAULT_MODE": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^(auto|light|dark)$"
            }
          ]
        },
        "TEMPLATES_DIR": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^/\\S*$"
            }
          ]
        },
        "LANGUAGES": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^[a-z]{2,3}([ ,;]+[a-z]{2,3})*$"
            }
          ]
        },
        "DEFAULT_LANG": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^[a-z]{2,3}$"
            }
          ]
        },
        "TRANSLATIONS_DIR": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^/\\S*$"
            }
          ]
        },
        "TTL_OPTIONS": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^[0-9]+[smhdwSMHDW]?([\\s,;]+[0-9]+[smhdwSMHDW]?)*$"
            }
          ]
        },
        "DEFAULT_TTL": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^[0-9]+[smhdwSMHDW]?([\\s,;]+[0-9]+[smhdwSMHDW]?)*$"
            }
          ]
        },
        "MAX_TTL": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 300,
              "maximum": 31536000
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "MAX_VIEWS": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "RECEIPT_KEEP": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 31536000
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "MAX_SECRET_CHARS": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "MIN_SECRET_CHARS": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "MIN_PASSPHRASE_LENGTH": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "PASSPHRASE_COMPLEXITY": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^(?i:(all|upper|lower|digit|symbol)([\\s,;]+(all|upper|lower|digit|symbol))*)$"
            }
          ]
        },
        "REQUIRE_PASSPHRASE": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^$|^(?i:1|0|true|false|yes|no|on|off|unless-recipients)$"
            }
          ]
        },
        "PASSPHRASE_ATTEMPTS": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "CONFIRM_CHECKBOX": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^$|^(?i:1|0|true|false|yes|no|on|off)$"
            }
          ]
        },
        "CONFIRM_TEXT": {
          "type": "string",
          "maxLength": 1000
        },
        "CONFIRM_TEXT_EN": {
          "type": "string",
          "maxLength": 1000
        },
        "CONFIRM_TEXT_DE": {
          "type": "string",
          "maxLength": 1000
        },
        "GENERATOR_LENGTH": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 8,
              "maximum": 128
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
        },
        "GENERATOR_COMPLEXITY": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^$|^(?i:(all|upper|lower|digit|symbol)([\\s,;]+(all|upper|lower|digit|symbol))*)$"
            }
          ]
        },
        "RATE_LIMIT_CREATE": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "string",
              "pattern": "^$|^[0-9]+$"
            }
          ]
