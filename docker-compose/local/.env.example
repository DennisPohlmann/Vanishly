# Settings of docker-compose/local: copy to .env next to docker-compose.yml
# (required) and set your own. Sign-in with Vanishly's own accounts
# (AUTH_PROVIDER=local), no identity provider; see README.md and
# docs/providers/local.md. It lists every setting; an empty value means the
# default. A wrong value or a misspelt name stops the start with a message
# (docker compose logs vanishly). docs/CONFIG.md explains each one.
# Put real secrets only into .env (git-ignored), never into this file.
# --- Server
# public address, e.g. https://ots.example.com (links of /v1/share)
# for a test on this machine; on a server https://ots.example.com behind a reverse proxy with TLS
BASE_URL=http://localhost:3000
# listen address inside the container
HOST=0.0.0.0
# listen port inside the container (see ports: in docker-compose.yml)
PORT=3000
# reverse proxies in front: 1, loopback, 10.0.0.0/8, or false
TRUST_PROXY=false
# send Strict-Transport-Security (only behind HTTPS)
HSTS=false
# one line per request, ids replaced by :id
ACCESS_LOG=true

# --- Redis
# with password: redis://:change-me@redis:6379
REDIS_URL=redis://redis:6379
# Or the URL from a file (Docker secret), with REDIS_URL empty.
#REDIS_URL_FILE=
# External Redis: set REDIS_URL (e.g. rediss://app:change-me@redis.example.com:6380)
# and remove the redis service and depends_on from docker-compose.yml (docs/CONFIG.md#redis).
# own CA (PEM) for rediss://
REDIS_TLS_CA_FILE=
# prefix of all keys
REDIS_PREFIX=vanishly:

# --- Design and language
# name in the header and the tab title (empty: the template's, usually Vanishly)
SITE_NAME=
# default, aurora, example-brand or your own
TEMPLATE=default
# auto (system setting), light or dark (empty: the template's choice, usually auto)
DEFAULT_MODE=
TEMPLATES_DIR=/var/lib/vanishly/templates
# languages served, e.g. en,de (empty: all translations, en,de,es,fr,it,nl,pl,pt)
LANGUAGES=
# when the browser names none of LANGUAGES
DEFAULT_LANG=en
# own translations (fr.json, ...)
TRANSLATIONS_DIR=/var/lib/vanishly/translations

# --- Expiry and views
# dropdown entries, e.g. 15m,1h,1d,7d (empty: 5m,1h,1d,3d,7d up to MAX_TTL)
TTL_OPTIONS=
# preselected entry, e.g. 1d (empty: 1 day or the closest option)
DEFAULT_TTL=
# longest expiry in seconds (empty: 604800, or the largest TTL_OPTIONS entry)
MAX_TTL=
# most views per secret (1-100)
MAX_VIEWS=10
# seconds a receipt stays after its secret is gone
RECEIPT_KEEP=604800

# --- Secret and passphrase rules
MAX_SECRET_CHARS=10000
MIN_SECRET_CHARS=1
# 0 = any
MIN_PASSPHRASE_LENGTH=0
# upper,lower,digit,symbol or all (empty: none)
PASSPHRASE_COMPLEXITY=
# true, or unless-recipients: only secrets without recipients
REQUIRE_PASSPHRASE=false
# wrong passphrases before the secret burns
PASSPHRASE_ATTEMPTS=5

# --- Confirmation checkbox before "Create secret link"
CONFIRM_CHECKBOX=false
# all languages (empty: built-in text); CONFIRM_TEXT_<CODE> for one language,
# any code, e.g. CONFIRM_TEXT_FR or CONFIRM_TEXT_SV (also for TRANSLATIONS_DIR)
CONFIRM_TEXT=
CONFIRM_TEXT_EN=
CONFIRM_TEXT_DE=

# --- "Generate" button
# 8-128
GENERATOR_LENGTH=20
# upper,lower,digit,symbol or all
GENERATOR_COMPLEXITY=all

# --- Rate limits per client IP and window; 0 switches one off
RATE_LIMIT_CREATE=30
RATE_LIMIT_READ=120
RATE_LIMIT_WINDOW=600
# 32+ characters (openssl rand -base64 48), or RATE_LIMIT_KEY_FILE; empty: random per process
RATE_LIMIT_KEY=
# Or from a file (Docker secret).
#RATE_LIMIT_KEY_FILE=

# --- IP access: who may create, read and use the admin area (empty = everybody)
# IP addresses or networks (IPv4/IPv6 CIDR), comma-separated, at most 100 per
# list. An ALLOWED list lets only its networks in; a DENIED address is always
# refused (403). Checked on the client IP as the rate limits see it (TRUST_PROXY).
# CREATE: the form, POST /api/v1/secrets and /share, people and group search,
# status page and burn. READ: /s/<id>, opening and revealing a secret.
# ADMIN: /admin and /api/v1/admin/* (a wrong network locks you out of the
# admin area: fix the setting and restart). Sign-in and API tokens are never restricted.
CREATE_ALLOWED_IPS=
CREATE_DENIED_IPS=
READ_ALLOWED_IPS=
READ_DENIED_IPS=
ADMIN_ALLOWED_IPS=
ADMIN_DENIED_IPS=

# --- API
# false: the API only serves this server's own pages
ENABLE_API=true
# API reference (Scalar) at /api/docs
ENABLE_API_DOCS=true
# The older name of ENABLE_API_DOCS.
#API_DOCS=
# "API" link in the footer
ENABLE_API_LINK=true
# POST /api/v1/share (server-side encryption for scripts)
ENABLE_SHARE_API=true
# GET /api/v1/secrets/{id} (state without a view)
ENABLE_SECRET_META_API=true
# GET /api/v1/config (limits and options)
ENABLE_CONFIG_API=true
# GET /api/v1/me (who is signed in)
ENABLE_ME_API=true
# POST /api/v1/secrets (false: only the form)
ENABLE_CREATE_API=true
# POST /api/v1/secrets/{id}/reveal (false: only the reveal page)
ENABLE_REVEAL_API=true
# GET /api/v1/receipts/{id}, .../burn (false: only the status page)
ENABLE_RECEIPT_API=true
# GET /api, /api/v1 (index)
ENABLE_API_INDEX=true
# POST /api/v1/open (open a link with its passphrase from scripts)
ENABLE_OPEN_API=true

# --- Features (true = on)
# passphrase field
ENABLE_PASSPHRASE=true
# views dropdown (false: always 1 view)
ENABLE_VIEWS=true
# status page for the sender
ENABLE_RECEIPTS=true
# "Burn now" on the status page
ENABLE_BURN=true
# times of the views on the status page
ENABLE_VIEW_LOG=true
# share link again on the status page
ENABLE_RECEIPT_SHARE_LINK=true
# "Generate" button
ENABLE_GENERATOR=true
# language link in the header
ENABLE_LANG_SWITCH=true
# light/dark button in the header
ENABLE_THEME_TOGGLE=true
# "Powered by Vanishly" link to GitHub in the footer
ENABLE_GITHUB_LINK=true
# Version shown in the footer; the image sets it, so leave it out.
#VANISHLY_VERSION=

# --- Sign-in and recipients (docs/CONFIG.md); off with AUTH_PROVIDER=none,
# then the others must stay empty
# none, entra, keycloak, okta, auth0, google, ping, jumpcloud, cognito or oidc (needs BASE_URL; docs/providers)
AUTH_PROVIDER=local
# entra: directory (tenant) id
ENTRA_TENANT_ID=
# entra: application (client) id
ENTRA_CLIENT_ID=
# or ENTRA_CLIENT_SECRET_FILE (Docker secret)
ENTRA_CLIENT_SECRET=
# Or from a file (Docker secret).
#ENTRA_CLIENT_SECRET_FILE=
# empty: https://login.microsoftonline.com
ENTRA_AUTHORITY=
# true: Graph (GroupMember.Read.All): group search, >200 groups
ENTRA_GRAPH=
# address shown for a person: upn or mail (vorname.nachname@, from Graph or the
# verified email claim); empty: upn
ENTRA_SHOW_ADDRESS=
# empty: https://graph.microsoft.com
ENTRA_GRAPH_URL=
# oidc and presets: issuer URL
OIDC_ISSUER=
OIDC_CLIENT_ID=
# or OIDC_CLIENT_SECRET_FILE
OIDC_CLIENT_SECRET=
# Or from a file (Docker secret).
#OIDC_CLIENT_SECRET_FILE=
# empty: openid profile email
OIDC_SCOPES=
# empty: the preset's (groups; cognito:groups)
OIDC_GROUPS_CLAIM=
# only these domains sign in (required for google)
AUTH_ALLOWED_DOMAINS=
# presets, true: people/group search in the directory
DIRECTORY_API=
# empty: from the issuer
DIRECTORY_URL=
# keycloak, auth0, ping: own client (empty: the sign-in client)
DIRECTORY_CLIENT_ID=
# or DIRECTORY_CLIENT_SECRET_FILE
DIRECTORY_CLIENT_SECRET=
# Or from a file (Docker secret).
#DIRECTORY_CLIENT_SECRET_FILE=
# okta, jumpcloud; or DIRECTORY_API_TOKEN_FILE
DIRECTORY_API_TOKEN=
# Or from a file (Docker secret).
#DIRECTORY_API_TOKEN_FILE=
# google: service account key file
DIRECTORY_GOOGLE_CREDENTIALS_FILE=
# google: admin the service account acts for
DIRECTORY_GOOGLE_ADMIN=
# Local accounts (AUTH_PROVIDER=local only): first admin, password length, attempts
# the first admin (an e-mail address), created at the first start only
LOCAL_ADMIN_USERNAME=admin@example.com
# its password, 12+ characters; remove it after the first sign-in
LOCAL_ADMIN_PASSWORD=
# Or from a file (Docker secret).
#LOCAL_ADMIN_PASSWORD_FILE=
LOCAL_PASSWORD_MIN_LENGTH=
LOCAL_LOGIN_ATTEMPTS=
# cognito: add AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY here
# 32+ random characters (openssl rand -base64 48), or AUTH_SECRET_FILE
AUTH_SECRET=
# Or from a file (Docker secret).
#AUTH_SECRET_FILE=
# seconds a sign-in lasts (empty: 28800)
AUTH_SESSION_TTL=
# provider (default; entra: local): sign out at the provider too
AUTH_LOGOUT=
# true: sign in silently when the provider knows the visitor
AUTH_AUTO_LOGIN=
# signed-in (default) or anyone
AUTH_CREATE=
# accept bearer tokens with this audience, e.g. api://<client id>
AUTH_API_AUDIENCE=
# off, optional (default) or required
RECIPIENTS=
# empty: 10
RECIPIENTS_MAX=
# Name=<group id>,... or * (search, needs ENTRA_GRAPH or DIRECTORY_API)
RECIPIENT_GROUPS=
# group whose members the form suggests (needs ENTRA_GRAPH or DIRECTORY_API)
RECIPIENT_USER_GROUP=
# allowed e-mail domains, e.g. example.com
RECIPIENT_DOMAINS=
# true: only addresses of users in the directory (entra with ENTRA_GRAPH); empty: false
RECIPIENTS_DIRECTORY_ONLY=
# true: show who opened it on the status page
RECEIPT_SHOW_VIEWER=
# off (default), optional or required: who looks after a secret
RESPONSIBLE=
# link or signed-in (empty: signed-in with sign-in, else link)
STATUS_ACCESS=

# Audit log (docs/CONFIG.md#audit-log); a file needs a writable volume.
# true: audit events (who, what, when, for whom), hash-chained
# the audit log in Redis: sign-ins, user changes, "My secrets"
AUDIT_LOG=true
# ecs (default), otel or plain
AUDIT_LOG_FORMAT=
# true: pretty-printed (development only)
AUDIT_LOG_PRETTY=
# e.g. /var/log/vanishly/audit.jsonl
AUDIT_LOG_FILE=
# empty: true
AUDIT_LOG_FSYNC=
# empty: true without file and Redis
AUDIT_LOG_STDOUT=
# true: Redis stream (admin view across replicas)
AUDIT_LOG_REDIS=true
# empty: 0 = keep all
AUDIT_LOG_REDIS_MAXLEN=
# at least 32 characters: signs every event
AUDIT_LOG_HMAC_KEY=
# Or from a file (Docker secret).
#AUDIT_LOG_HMAC_KEY_FILE=
# closed (default) or open
AUDIT_LOG_FAIL=
# full (default), hash or off
AUDIT_LOG_IP=
# empty: true
AUDIT_LOG_USER_AGENT=
# empty: the host name
AUDIT_LOG_INSTANCE=
# empty: 100
AUDIT_LOG_CHECKPOINT=
# udp://, tcp:// or tls://host:port
AUDIT_LOG_SYSLOG=
# Own CA (PEM) for tls://
#AUDIT_LOG_SYSLOG_CA_FILE=
# e.g. http://otel-collector:4318/v1/logs
AUDIT_LOG_OTLP_URL=
# name=value,...
AUDIT_LOG_OTLP_HEADERS=
# Or from a file (Docker secret).
#AUDIT_LOG_OTLP_HEADERS_FILE=
# POST every event here
AUDIT_LOG_WEBHOOK_URL=
# Authorization header, e.g. Splunk change-me
AUDIT_LOG_WEBHOOK_AUTH=
# Or from a file (Docker secret).
#AUDIT_LOG_WEBHOOK_AUTH_FILE=
# json (default) or splunk
AUDIT_LOG_WEBHOOK_FORMAT=
# off (default), optional or required
AUDIT_COMMENT=
# empty: 500
AUDIT_COMMENT_MAX=

# API tokens and admins (need sign-in; docs/CONFIG.md#api-tokens)
# true: personal API tokens ("API tokens" in the user menu)
API_TOKENS=
# true: scripts need such a token
API_TOKEN_REQUIRED=
# only these addresses may make tokens
API_TOKEN_USERS=
# only these groups may make tokens
API_TOKEN_GROUPS=
# optional (default) or required
API_TOKEN_IP_BINDING=
# empty: 30d,60d,90d,never (d, m months, y)
API_TOKEN_EXPIRY_OPTIONS=
# empty: 90d
API_TOKEN_DEFAULT_EXPIRY=
# empty: never (no cap), e.g. 1y
API_TOKEN_MAX_EXPIRY=
# active tokens per user, empty: 10, 0 = no limit
API_TOKEN_MAX_PER_USER=
# calls per token per window, empty: 0 = off
API_TOKEN_RATE_LIMIT=
# optional (default) or required
API_TOKEN_COMMENT=
# empty: create,read,status
API_TOKEN_ALLOWED_SCOPES=
# empty: create,status
API_TOKEN_DEFAULT_SCOPES=
# <group>=<scopes>;...
API_TOKEN_SCOPES_BY_GROUP=
# empty: true (with admins); scopes and limits per user/group on /admin
API_TOKEN_ADMIN_POLICY=
# admins: audit log page and all tokens
ADMIN_USERS=
ADMIN_GROUPS=
# empty: true
AUDIT_ADMIN_VIEW=
# empty: true; the admin interface /admin and admin API
ADMIN_UI=
# empty: true (with AUDIT_LOG_REDIS); "My secrets" in the user menu
MY_SECRETS=
# empty: true; admins may burn any secret
ADMIN_BURN=
# empty: true; technical users
API_SERVICE_ACCOUNTS=
# empty: true (with admins); "admin" scope for technical users' tokens
API_ADMIN_TOKENS=
# empty: true
API_ADMIN_TOKEN_REQUIRE_IP=
# empty: 90d
API_ADMIN_TOKEN_MAX_EXPIRY=
# empty: true
API_ADMIN_TOKEN_CAN_ISSUE_ADMIN=
# required (default) or optional
API_ADMIN_COMMENT=
