# Values for docker-compose/keycloak: copy to .env and set your own.
# Demo only, never for a real server. Make random values with:
#   for k in KC_ADMIN_PASSWORD KC_CLIENT_SECRET KC_DIRECTORY_CLIENT_SECRET VANISHLY_AUTH_SECRET; do
#     sed -i "s|^$k=.*|$k=$(openssl rand -hex 24)|" .env; done

# Ports on 127.0.0.1 (Vanishly and Keycloak).
VANISHLY_PORT=3000
KEYCLOAK_PORT=8080

# Keycloak admin console: user "admin" and this password.
KC_ADMIN_PASSWORD=change-me
# Secrets of the two Keycloak clients (login, people search).
KC_CLIENT_SECRET=change-me-client
KC_DIRECTORY_CLIENT_SECRET=change-me-directory
# Vanishly's AUTH_SECRET, at least 32 characters.
VANISHLY_AUTH_SECRET=change-me-change-me-change-me-change-me
# Password of the demo users alice, bob and carol (DEMO ONLY).
DEMO_PASSWORD=change-me-demo

# Optional: another Vanishly image, e.g. one built locally.
#VANISHLY_IMAGE=ghcr.io/dennispohlmann/vanishly:latest
