# Keycloak's own passwords: copy to keycloak.env and set your own. Only the
# keycloak service gets this file, so they stay out of Vanishly's environment.
# Demo only, never for a real server.

# Keycloak admin console: this user and password.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Password of the demo users alice, bob and carol (DEMO ONLY).
DEMO_PASSWORD=change-me-demo
