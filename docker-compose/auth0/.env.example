# Settings of docker-compose/auth0: copy to .env next to docker-compose.yml
# (required) and set your own. Sign-in with Auth0; the steps at the
# provider are in README.md and docs/providers/auth0.md. It lists every setting:
# first what this example sets, then the others with their defaults. An empty
# value means the default. A wrong value or a misspelt name stops the start
# with a message (docker compose logs vanishly). docs/CONFIG.md explains each one.
# Put real secrets only into .env (git-ignored), never into this file.

# --- Address
# Public address, e.g. https://ots.example.com; used for the links that POST
# /api/v1/share returns. Required with sign-in (any AUTH_PROVIDER but none):
# the redirect URI is <BASE_URL>/auth/callback; https://, or http://localhost
# for a test. Default: from the request.
# In this example: public address; the redirect URI at Auth0 is
# <BASE_URL>/auth/callback. For a test on this machine http://localhost:3000;
# on a server https://ots.example.com behind a reverse proxy with TLS (then
# also TRUST_PROXY=1 and HSTS=true).
BASE_URL=http://localhost:3000
# Listen port. Default: 3000.
PORT=3000
# Redis connection, any host: with password redis://:change-me@host:6379, with
# an ACL user redis://app:change-me@host:6379, database 2 redis://host:6379/2,
# TLS rediss://host:6380 (certificate checked against the system CAs). Default:
# redis://localhost:6379. Compose: for an external Redis set REDIS_URL here and
# remove the redis service and depends_on from docker-compose.yml
# (docs/CONFIG.md#redis).
# In this example: The redis service of docker-compose.yml; with password:
# redis://:change-me@redis:6379
REDIS_URL=redis://redis:6379

# --- Auth0 (sign-in application, see README.md)
# none, entra (Microsoft Entra ID), a preset (keycloak, okta, auth0, google,
# ping, jumpcloud, cognito) or oidc (any other OpenID Connect provider), or
# local (Vanishly's own user accounts in Redis, no provider;
# docs/providers/local.md). The presets use the OIDC_* settings and know the
# provider's issuer format, groups claim and directory (providers
# (docs/providers/README.md)). Needs BASE_URL: the redirect URI is
# <BASE_URL>/auth/callback (with local: the origin the sign-in form must come
# from). Default: none.
AUTH_PROVIDER=auth0
# Issuer URL, e.g. https://sso.example.com/realms/main; its
# /.well-known/openid-configuration must be reachable. Auth0 and JumpCloud keep
# their trailing /. Required for oidc and the presets.
# In this example: https://<tenant>.<region>.auth0.com/ or your custom domain
OIDC_ISSUER=
# The confidential client; OIDC_CLIENT_SECRET_FILE instead of the secret.
# Required for oidc and the presets.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Or a file whose first line is used as OIDC_CLIENT_SECRET, e.g. a Docker
# secret (/run/secrets/...); set only one of both (both set stops the start).
# Default: none.
#OIDC_CLIENT_SECRET_FILE=
# The ID token claim with the user's groups, e.g. a namespaced claim of an
# Auth0 Action. Default: groups (cognito:groups for cognito, none for auth0 and
# google).
# In this example: Auth0 puts no groups into tokens: the claim your post-login
# Action sets, e.g. https://ots.example.com/groups (README.md); empty: no
# groups
OIDC_GROUPS_CLAIM=
# Only accounts with an address of these domains sign in, e.g. example.com.
# Required for google (also checks the Workspace domain, hd). Default: any.
# In this example: only addresses of these domains sign in, e.g. example.com
# (with social or database connections anybody could sign up otherwise)
AUTH_ALLOWED_DOMAINS=
# true: use the provider's directory for the people search, the group search
# and (Google) the groups of a user. Presets only; Entra uses ENTRA_GRAPH.
# Access per provider: providers (docs/providers/README.md). cognito reads the
# standard AWS variables (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY,
# AWS_SESSION_TOKEN for temporary keys, or AWS_ROLE_ARN and
# AWS_WEB_IDENTITY_TOKEN_FILE on EKS); they are no Vanishly settings, add them
# to this file. Default: false.
# In this example: true: people search in Auth0 (Management API with read:users
# and read:roles). false: no search (then leave DIRECTORY_* empty).
DIRECTORY_API=true
# keycloak, auth0, ping: a client of its own for the directory (service
# account, machine-to-machine app, worker); DIRECTORY_CLIENT_SECRET_FILE
# instead of the secret. Default: the sign-in client.
# In this example: Machine to Machine application; empty: the sign-in
# application
DIRECTORY_CLIENT_ID=
DIRECTORY_CLIENT_SECRET=
# Or a file whose first line is used as DIRECTORY_CLIENT_SECRET, e.g. a Docker
# secret (/run/secrets/...); set only one of both (both set stops the start).
# Default: none.
#DIRECTORY_CLIENT_SECRET_FILE=
# The directory API's address, where it differs (Auth0 with a custom domain,
# JumpCloud EU, an internal Keycloak admin address). Default: from the issuer.
# In this example: empty: the issuer; with a custom domain
# https://<tenant>.<region>.auth0.com
DIRECTORY_URL=
# At least 32 random characters (openssl rand -base64 48); or AUTH_SECRET_FILE.
# Keys the hashes of the recipients: changing it locks every open restricted
# secret. Required.
AUTH_SECRET=
# Or a file whose first line is used as AUTH_SECRET, e.g. a Docker secret
# (/run/secrets/...); set only one of both (both set stops the start). Default:
# none.
#AUTH_SECRET_FILE=
# At least 32 characters, no whitespace (openssl rand -base64 48): keys the IP
# hashes of the rate limits. Use the same value on all replicas so they share
# the limits. Unset: a random key per process, so limits are per process and
# reset on restart, with a warning at start (fine for one replica). Changing it
# starts the counters over. The Helm chart generates one. Default: random per
# process.
RATE_LIMIT_KEY=
# Or a file whose first line is used as RATE_LIMIT_KEY, e.g. a Docker secret
# (/run/secrets/...); set only one of both (both set stops the start). Default:
# none.
#RATE_LIMIT_KEY_FILE=

# --- IP access: who may create, read and use the admin area (empty = everybody)
# IP addresses or networks (IPv4/IPv6 CIDR), comma-separated, at most 100 per
# list. An ALLOWED list lets only its networks in; a DENIED address is always
# refused (403). Checked on the client IP as the rate limits see it (TRUST_PROXY).
# CREATE: the form, POST /api/v1/secrets and /share, people and group search,
# status page and burn. READ: /s/<id>, opening and revealing a secret.
# ADMIN: /admin and /api/v1/admin/* (a wrong network locks you out of the
# admin area: fix the setting and restart). Sign-in and API tokens are never restricted.
# Client IPs that may / may not create: the form, POST /api/v1/secrets and
# /share, people and group search, status page and burn (details:
# docs/CONFIG.md#ip-access). Default: none: everybody.
CREATE_ALLOWED_IPS=
CREATE_DENIED_IPS=
# Client IPs that may / may not open secrets: /s/<id>, GET
# /api/v1/secrets/{id}, reveal, /api/v1/open (details:
# docs/CONFIG.md#ip-access). Default: none: everybody.
READ_ALLOWED_IPS=
READ_DENIED_IPS=
# Client IPs that may / may not use the admin area: /admin and /api/v1/admin/*
# (details: docs/CONFIG.md#ip-access). Default: none: everybody.
ADMIN_ALLOWED_IPS=
ADMIN_DENIED_IPS=
# provider: "Sign out" also ends the session at the provider, which then asks
# again at the next sign-in; needs <BASE_URL>/auth/logged-out as post logout
# redirect URI there. local: only Vanishly signs out (with Entra the default,
# as the Microsoft session is shared with Microsoft 365). Default: provider
# (Entra: local).
# In this example: provider (default): sign out of Auth0 too (needs
# RP-Initiated Logout and <BASE_URL>/auth/logged-out in Allowed Logout URLs);
# local: of Vanishly only
AUTH_LOGOUT=

# --- Recipients, groups and admins (values are the names in OIDC_GROUPS_CLAIM)
# off (no recipients field), optional, or required (every secret must name
# someone). Default: optional.
RECIPIENTS=optional
# Groups a sender may search for and pick in the form: Name=<id>,... (Entra:
# the group's object id; otherwise the value in the groups claim), or * for a
# search over all groups in the directory (Entra with ENTRA_GRAPH=true;
# keycloak, okta, google, cognito with DIRECTORY_API=true). Default: none.
# In this example: groups to pick: Name=<role name>,... (needs
# OIDC_GROUPS_CLAIM; no group search with Auth0)
RECIPIENT_GROUPS=
# People search in the form: the group whose members the form suggests while
# typing a name (Entra: object id; Keycloak: path or id; Okta, PingOne,
# JumpCloud: group id; Auth0: role id; Google: group address; Cognito: group
# name). Needs ENTRA_GRAPH=true or DIRECTORY_API=true (details:
# docs/CONFIG.md#people-search). Default: none.
# In this example: id of the role whose users the form suggests (rol_..., needs
# DIRECTORY_API=true)
RECIPIENT_USER_GROUP=
# Admins get the whole admin interface (/admin, "Administration" in the user
# menu) and the admin API. ADMIN_GROUPS as in the groups claim, like
# RECIPIENT_GROUPS (Keycloak: /vanishly-admins; Entra: the object id); see
# Admin interface (docs/CONFIG.md#admin-interface). Default: none.
# In this example: admins: audit log page and all tokens; e-mail addresses,
# e.g. jdoe@example.com
ADMIN_USERS=
# Admins get the whole admin interface (/admin, "Administration" in the user
# menu) and the admin API. ADMIN_GROUPS as in the groups claim, like
# RECIPIENT_GROUPS (Keycloak: /vanishly-admins; Entra: the object id); see
# Admin interface (docs/CONFIG.md#admin-interface). Default: none.
# In this example: admins by group: names in OIDC_GROUPS_CLAIM, comma-separated
ADMIN_GROUPS=

# --- Server
# Listen address (127.0.0.1 in the systemd unit). Default: 0.0.0.0.
HOST=0.0.0.0
# Reverse proxies in front: a number of hops (1), loopback, or address ranges;
# needed for correct client IPs in the rate limits. Default: false.
TRUST_PROXY=false
# Send Strict-Transport-Security (only if served via HTTPS). Default: false.
HSTS=false
# One line per request to stdout (method, path with ids replaced by :id,
# status, time). Default: true.
ACCESS_LOG=true

# --- Redis
# File with the URL (first line) instead of REDIS_URL, e.g. a Docker secret, so
# the password is not in the environment. Default: none.
#REDIS_URL_FILE=
# PEM file of an own CA for rediss:// (e.g. a company CA); the certificate is
# always checked. Default: none.
REDIS_TLS_CA_FILE=
# Prefix of all keys, to share one Redis with other apps. Default: vanishly:.
REDIS_PREFIX=vanishly:

# --- Design and language
# Name in the header and in the browser tab title (<page> - <name>), e.g. ACME
# Secrets; at most 80 characters. Wins over siteName in template.json. Default:
# the template's siteName, otherwise Vanishly.
SITE_NAME=
# Design template, see templates/README.md. Default: default.
TEMPLATE=default
# Light or dark at the first visit: auto (the visitor's system setting), light
# or dark. A visitor's own choice with the button wins (unless
# ENABLE_THEME_TOGGLE=false). Default: the template's defaultMode, usually
# auto.
DEFAULT_MODE=
# Folder with own templates; searched before the built-in templates/. Default:
# /var/lib/vanishly/templates.
TEMPLATES_DIR=/var/lib/vanishly/templates
# Languages served, comma-separated. Only these count for ?lang=, the lang
# cookie and Accept-Language. One language (LANGUAGES=en) serves every page in
# it and hides the language link; two show a link to the other one, more a
# language menu. A code without a translation stops the start. Default: all
# translations: en,de,es,fr,it,nl,pl,pt.
LANGUAGES=
# Language when the browser names none of LANGUAGES (and no ?lang= or cookie
# decides); must be one of LANGUAGES. Default: en (or the first of LANGUAGES
# without en).
DEFAULT_LANG=en
# Folder with own translations: <code>.json (e.g. fr.json) adds a language,
# de.json replaces single German texts; missing keys come from English. Plain
# JSON files ("key": "text") up to 512 KB, no symbolic links. Default:
# /var/lib/vanishly/translations.
TRANSLATIONS_DIR=/var/lib/vanishly/translations

# --- Expiry and views
# Time spans (all settings below that take one): a number and a unit,
# s seconds, m or min minutes, h hours, d days, w weeks, mo months, y years,
# also written out (30 minutes, 6 months). m is always minutes, months are mo.
# A plain number is seconds. Details: docs/CONFIG.md#durations.
# Entries of the expiry dropdown, comma-separated: 15m,1h,1d,3d,7d (1 minute to
# 1 year). Without it the form offers 5m, 1h, 1d, 3d, 7d, 14d, 30d, 90d up to
# MAX_TTL. Default: built-in steps.
TTL_OPTIONS=
# Preselected expiry, also used by the API without ttl; with TTL_OPTIONS it
# must be one of them, e.g. 1d. Default: 1 day, or the option closest to it.
DEFAULT_TTL=
# Longest expiry the API accepts, 5m to 1y. Default: 7d, or the largest of
# TTL_OPTIONS.
MAX_TTL=
# Most views a secret can have (1 to 100). Default: 10.
MAX_VIEWS=10
# How long a receipt (the status page) stays after its secret expired, 0 to 1y,
# e.g. 1m, 30d, 6mo, 1y; 0: it goes with the secret. Default: 7d.
RECEIPT_KEEP=7d

# --- Secret and passphrase rules
# Longest secret in characters. Default: 10000.
MAX_SECRET_CHARS=10000
# Shortest secret in characters, e.g. 12 to refuse short passwords (details:
# docs/CONFIG.md#minimum-lengths-and-passphrase-rules). Default: 1.
MIN_SECRET_CHARS=1
# Shortest passphrase in characters; 0 = any (details:
# docs/CONFIG.md#minimum-lengths-and-passphrase-rules). Default: 0.
MIN_PASSPHRASE_LENGTH=0
# Character classes the passphrase must contain, comma-separated: upper, lower,
# digit, symbol, or all (details:
# docs/CONFIG.md#minimum-lengths-and-passphrase-rules). Default: none.
PASSPHRASE_COMPLEXITY=
# true: every secret needs a passphrase. unless-recipients: every secret
# without recipients needs one; with recipients (sign-in) it is optional. The
# form shows the field as required until a recipient is chosen; the API answers
# passphrase_required ("A passphrase is required when no recipients are
# given"). Without sign-in this means: always. Default: false.
REQUIRE_PASSPHRASE=false
# Wrong passphrases before the secret is destroyed. Default: 5.
PASSPHRASE_ATTEMPTS=5

# --- Confirmation checkbox before "Create secret link"
# true: the sender must tick a confirmation before creating the link; the API
# then needs "confirmed": true and otherwise answers confirmation_required with
# the same text as the checkbox. Default: false.
CONFIRM_CHECKBOX=false
# Own text of the confirmation (CONFIRM_CHECKBOX) for all languages without a
# CONFIRM_TEXT_<CODE> of their own. Default: the built-in text of the language.
CONFIRM_TEXT=
# Own English text of the confirmation (CONFIRM_CHECKBOX); every language code
# works the same way (CONFIRM_TEXT_<CODE>, e.g. CONFIRM_TEXT_PL), a code
# without a translation stops the start. Default: the built-in text ("I confirm
# that this secret contains only one password: ...").
CONFIRM_TEXT_EN=
# Own German text of the confirmation (CONFIRM_CHECKBOX). Default: the built-in
# German text.
CONFIRM_TEXT_DE=

# --- "Generate" button
# Length of the password of the "Generate" button (8 to 128). Default: 20.
GENERATOR_LENGTH=20
# Character classes of the generated password: upper, lower, digit, symbol or
# all; each chosen class appears at least once. Look-alikes (0/O, 1/l/I) are
# left out. Default: all.
GENERATOR_COMPLEXITY=all

# --- Rate limits per client IP and window; 0 switches one off
# New secrets per client IP and window; 0 = off. Default: 30.
RATE_LIMIT_CREATE=30
# Reads, reveals, receipts and burns per client IP and window; with sign-in
# also /auth/login and /auth/callback (own counter), with MCP_OAUTH also
# /oauth/* (own counter). With sign-in, all requests of one client IP together
# (not static files, /healthz) may reach 10 × the larger of RATE_LIMIT_READ and
# RATE_LIMIT_CREATE per window. 0 = off. Default: 120.
RATE_LIMIT_READ=120
# Window of the rate limits, 1s to 1d. Default: 10m.
RATE_LIMIT_WINDOW=10m

# --- API
# true or false (also 0, no, off). false: No public API: every API endpoint and
# /api/openapi.json answer 404, except the calls of this server's own pages;
# also switches off ENABLE_API_DOCS, ENABLE_SHARE_API, ENABLE_OPEN_API,
# ENABLE_MCP and the footer link (details: docs/CONFIG.md#api-access). Default:
# true.
ENABLE_API=true
# true or false (also 0, no, off). true: the MCP server at /mcp (its tool
# create_secret also needs ENABLE_SHARE_API=true); false: /mcp answers 404.
# ENABLE_MCP=true with ENABLE_API=false stops the start
# (details: docs/CONFIG.md#mcp-server). Default: false.
ENABLE_MCP=false
# true or false (also 0, no, off); the default is below. false: No browser
# sign-in for MCP clients: they need an API token made by hand, and /mcp works
# without one as far as the API does. On by default with sign-in,
# API_TOKENS=true and MCP; MCP_OAUTH=true without them stops the start
# (details: docs/CONFIG.md#sign-in-of-mcp-clients-mcp_oauth).
MCP_OAUTH=
# MCP protocol revisions /mcp serves, comma-separated: 2026-07-28 (stateless:
# version, client and capabilities in each request's _meta, mirrored in the
# MCP-Protocol-Version, Mcp-Method and Mcp-Name headers; server/discover),
# 2025-11-25 and 2025-06-18 (initialize, then the MCP-Protocol-Version header).
# Older revisions are never served (they had no version header). Only
# 2026-07-28 is the strictest choice of the CIS MCP Server Benchmark, but then
# clients that still start with initialize cannot connect
# (details: docs/CONFIG.md#mcp-server). Default: 2026-07-28,2025-11-25,2025-06-18.
MCP_PROTOCOL_VERSIONS=2026-07-28,2025-11-25,2025-06-18
# Lifetime of the API token an MCP client gets by signing in (MCP_OAUTH): 1d to
# 3660d, 1w, 1mo to 120mo (months), 1y to 10y, or never; at most API_TOKEN_MAX_EXPIRY.
# A shorter lifetime means signing in again more often (there are no refresh
# tokens). Default: 1d.
MCP_OAUTH_TOKEN_EXPIRY=1d
# true or false (also 0, no, off). false: No API reference page at /api/docs
# (API_DOCS is the older name). Default: true.
ENABLE_API_DOCS=true
# Older name of ENABLE_API_DOCS (true or false); ENABLE_API_DOCS wins when both
# are set. Default: true.
#API_DOCS=
# true or false (also 0, no, off). false: No "API" link in the footer; the API
# itself stays. Default: true.
ENABLE_API_LINK=true
# true or false (also 0, no, off). true: POST /api/v1/share (the server
# encrypts for scripts such as curl, so it sees the secret) and the MCP tool
# create_secret; false: 404, clients encrypt themselves (end to end, see
# docs/CLIENTS.md). Default: false.
ENABLE_SHARE_API=false
# true or false (also 0, no, off). false: GET /api/v1/secrets/{id} (a secret's
# state and passphrase parameters without using a view) answers 404; the reveal
# page gets what it needs with the page itself. Default: true.
ENABLE_SECRET_META_API=true
# true or false (also 0, no, off). false: GET /api/v1/config (limits and
# options) answers 404; the pages do not use it. Default: true.
ENABLE_CONFIG_API=true
# true or false (also 0, no, off). false: GET /api/v1/me (who is signed in)
# answers 404; the pages do not use it. Default: true.
ENABLE_ME_API=true
# true or false (also 0, no, off). false: POST /api/v1/secrets only for this
# server's form: scripts get 404. Default: true.
ENABLE_CREATE_API=true
# true or false (also 0, no, off). false: POST /api/v1/secrets/{id}/reveal only
# for this server's reveal page: scripts get 404. Default: true.
ENABLE_REVEAL_API=true
# true or false (also 0, no, off). false: GET /api/v1/receipts/{id} and
# .../burn only for this server's status page: scripts get 404. Default: true.
ENABLE_RECEIPT_API=true
# true or false (also 0, no, off). false: GET /api and GET /api/v1 (the index)
# answer 404. Default: true.
ENABLE_API_INDEX=true
# true or false (also 0, no, off). true: POST /api/v1/open (scripts open a
# link with its passphrase on the server, which sees key and secret); false:
# 404, clients decrypt themselves. Default: false.
ENABLE_OPEN_API=false

# --- Features (true = on)
# true or false (also 0, no, off). false: No passphrase field; the API refuses
# passphrases (passphrase_disabled). Cannot be combined with
# REQUIRE_PASSPHRASE, MIN_PASSPHRASE_LENGTH or PASSPHRASE_COMPLEXITY. Default:
# true.
ENABLE_PASSPHRASE=true
# true or false (also 0, no, off). false: No views dropdown: every secret can
# be opened once (MAX_VIEWS becomes 1). Default: true.
ENABLE_VIEWS=true
# true or false (also 0, no, off). false: No status page for the sender: no
# receipt is stored, /r/... and the receipt endpoints answer 404, receiptId is
# null. Also switches off the next three. Default: true.
ENABLE_RECEIPTS=true
# true or false (also 0, no, off). false: No "Burn now" button; the burn
# endpoint answers 404. Default: true.
ENABLE_BURN=true
# true or false (also 0, no, off). false: The status page shows no view times,
# and none are stored. Default: true.
ENABLE_VIEW_LOG=true
# true or false (also 0, no, off). false: The status page does not offer the
# share link again, and the receipt link no longer carries the key. Default:
# true.
ENABLE_RECEIPT_SHARE_LINK=true
# true or false (also 0, no, off). false: No "Generate" button. Default: true.
ENABLE_GENERATOR=true
# true or false (also 0, no, off). false: No language link in the header;
# ?lang= and the lang cookie no longer count, the browser language and
# DEFAULT_LANG still decide. To serve one language only, use LANGUAGES.
# Default: true.
ENABLE_LANG_SWITCH=true
# true or false (also 0, no, off). false: No light/dark button; the template's
# defaultMode or the system setting decides. Default: true.
ENABLE_THEME_TOGGLE=true
# true or false (also 0, no, off). false: No "Powered by Vanishly" link to
# GitHub in the footer. Default: true.
ENABLE_GITHUB_LINK=true
# Version shown in the footer. The image sets it, so leave it out. Default: the
# version of the image or package.json.
#VANISHLY_VERSION=

# --- More sign-in and recipient settings (docs/CONFIG.md). ENTRA_* and
# LOCAL_* are for other providers and must stay empty here.
# entra only: Directory (tenant) id, a GUID; tokens of other tenants are
# refused. Required with entra.
ENTRA_TENANT_ID=
# entra only: Application (client) id of the app registration. Required with
# entra.
ENTRA_CLIENT_ID=
# entra only: Client secret; or ENTRA_CLIENT_SECRET_FILE with a file that holds
# it (Docker secrets). Required with entra, unless
# ENTRA_CLIENT_CERTIFICATE_FILE is set.
ENTRA_CLIENT_SECRET=
# Or a file whose first line is used as ENTRA_CLIENT_SECRET, e.g. a Docker
# secret (/run/secrets/...); set only one of both (both set stops the start).
# Default: none.
#ENTRA_CLIENT_SECRET_FILE=
# entra only: Instead of the client secret: the certificate uploaded to the
# app registration (PEM file, Certificates & secrets -> Certificates). Vanishly
# signs in to Entra with its key (private_key_jwt). Needs
# ENTRA_CLIENT_KEY_FILE; leave ENTRA_CLIENT_SECRET empty. Default: none.
#ENTRA_CLIENT_CERTIFICATE_FILE=
# entra only: The unencrypted RSA private key of ENTRA_CLIENT_CERTIFICATE_FILE
# (PEM file; may be the same file as the certificate). Default: none.
#ENTRA_CLIENT_KEY_FILE=
# entra only: Only for national clouds, e.g. https://login.microsoftonline.us.
# Default: https://login.microsoftonline.com.
ENTRA_AUTHORITY=
# entra only: true: use Microsoft Graph for the group and people search and for
# users in more than 200 groups (docs/providers/entra.md). Default: false.
ENTRA_GRAPH=
# entra only: The address shown for a person in the header, the people search,
# the status page and the view log: upn (the sign-in name, e.g.
# jdoe@example.com) or mail (the mail address, e.g. john.doe@example.com; see
# Who is who (docs/providers/entra.md#who-is-who)). Default: upn.
ENTRA_SHOW_ADDRESS=
# entra only: Only for national clouds. Default: https://graph.microsoft.com.
ENTRA_GRAPH_URL=
# Scopes to ask for (must include openid); add the scope that puts the groups
# into the ID token if your provider needs one. Default: openid profile email.
OIDC_SCOPES=
# okta and jumpcloud with DIRECTORY_API=true (required there): the API token
# (Okta: of an admin with the Read-only Administrator role; JumpCloud: the API
# key), as issued, no spaces, 8 to 512 characters. Any other provider: leave
# empty. Default: none.
DIRECTORY_API_TOKEN=
# Or a file whose first line is used as DIRECTORY_API_TOKEN, e.g. a Docker
# secret (/run/secrets/...); set only one of both (both set stops the start).
# Default: none.
#DIRECTORY_API_TOKEN_FILE=
# google with DIRECTORY_API=true (required there): path of the JSON key file of
# a service account with domain-wide delegation (docs/providers/google.md). Any
# other provider: leave empty. Default: none.
DIRECTORY_GOOGLE_CREDENTIALS_FILE=
# google with DIRECTORY_API=true (required there): e-mail address of an admin
# the service account acts for, who can read users and groups. Any other
# provider: leave empty. Default: none.
DIRECTORY_GOOGLE_ADMIN=
# local only: the first admin (an e-mail address and its password), created at
# the start only while Redis holds no users; afterwards ignored, so a changed
# password stays. Without users and without them the start fails. Both or
# neither.
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=
# Or a file whose first line is used as LOCAL_ADMIN_PASSWORD, e.g. a Docker
# secret (/run/secrets/...); set only one of both (both set stops the start).
# Default: none.
#LOCAL_ADMIN_PASSWORD_FILE=
# local only: minimum password length, 8 to 128 (at most 1024 characters); also
# checked for LOCAL_ADMIN_PASSWORD. Default: 12.
LOCAL_PASSWORD_MIN_LENGTH=
# local only: sign-ins (and checks of the current password) per account and
# RATE_LIMIT_WINDOW; over it the account is locked until the window ends, a
# success clears the count. Comes on top of the per-IP limit of /auth/*.
# Default: 5.
LOCAL_LOGIN_ATTEMPTS=
# Lifetime of a sign-in, 5m to 7d. Default: 8h.
AUTH_SESSION_TTL=
# true: a visitor who is not signed in is signed in automatically when the
# provider still knows them (silent sign-in, prompt=none, once per browser
# tab); otherwise the page stays as it is. A sign-out in that tab is not
# undone. Default: false.
AUTH_AUTO_LOGIN=
# Who may create secrets: signed-in or anyone (restricting a secret always
# needs a sign-in). Default: signed-in.
AUTH_CREATE=
# Accept bearer tokens on the API with this audience, e.g. api://<client id>
# (details: docs/CONFIG.md#api-with-sign-in). Not with API_TOKEN_REQUIRED=true
# (the start stops). Default: none.
AUTH_API_AUDIENCE=
# Most recipients (addresses and groups) per secret, 1 to 50. Default: 10.
RECIPIENTS_MAX=
# Allowed e-mail domains of recipients, e.g. example.com,example.de. Default:
# any.
RECIPIENT_DOMAINS=
# true: every recipient and responsible person must be a user in the directory.
# Entra with ENTRA_GRAPH=true (User.Read.All): looked up by UPN or mail when
# the secret is created; the UPN and the mail both count afterwards. Unknown
# addresses: 400 unknown_recipient; Graph not reachable: 502
# directory_unavailable (entra.md (docs/providers/entra.md#who-is-who)).
# Default: false.
RECIPIENTS_DIRECTORY_ONLY=
# What the creator and the responsible people see on the status page of each
# signed-in person who opened the secret: name, email, both (true) or false
# (nothing). Kept with the view time, only with STATUS_ACCESS=signed-in; never
# shown to who only has the link or opened it. Set, it needs
# ENABLE_RECEIPTS=true (the start stops otherwise). Default: true (name and
# email; off without receipts).
RECEIPT_SHOW_VIEWER=
# People or groups who look after a secret: off, optional or required (every
# secret must name one). In the form a folded "Responsible" section with the
# same picker as the recipients; on the API responsible and responsibleGroups.
# Checked like recipients, stored as keyed hashes. Default: off.
RESPONSIBLE=
# Who may see the status page: link (whoever has the status link, as before) or
# signed-in (the creator, the responsible people and who opened the secret,
# after sign-in; only creator and responsible may burn it). See Status page
# (docs/CONFIG.md#status-page). Default: signed-in with sign-in, else link.
STATUS_ACCESS=

# --- Audit log (docs/CONFIG.md#audit-log); a file needs a writable volume.
# true: write an audit event for every action (who, what, when, for whom,
# comment, run id, source address), tamper-evident (hash chain). Works with and
# without sign-in. Default: false.
AUDIT_LOG=
# ecs (Elastic Common Schema: @timestamp, event.action, user.name, source.ip,
# trace.id, ...), otel (OpenTelemetry log data model: Timestamp, SeverityText,
# Body, Attributes with semantic conventions) or plain (Vanishly's own, short
# keys). Default: ecs.
AUDIT_LOG_FORMAT=
# true: pretty-printed JSON over several lines (for development; log shippers
# want one event per line). The verify command reads both. Default: false.
AUDIT_LOG_PRETTY=
# Append-only file, one event per line, e.g. /var/log/vanishly/audit.jsonl
# (created with mode 0640). The chain continues there after a restart. Default:
# none.
AUDIT_LOG_FILE=
# Flush every event to disk before the action goes on. Default: true.
AUDIT_LOG_FSYNC=
# Events on stdout too (Kubernetes / Docker log shipping). Default: true when
# no file and no Redis, else false.
AUDIT_LOG_STDOUT=
# Also into the Redis stream <prefix>audit; feeds the admin view across all
# replicas. Default: false.
AUDIT_LOG_REDIS=
# Keep about this many events in the stream (0: all; nothing is ever deleted
# unless set). Default: 0.
AUDIT_LOG_REDIS_MAXLEN=
# At least 32 characters: every event also gets an HMAC signature (sig), so a
# changed log cannot be re-chained without the key. Also keys the secret
# references and IP hashes (else AUTH_SECRET, else a random key per start).
# Default: none.
AUDIT_LOG_HMAC_KEY=
# Or a file whose first line is used as AUDIT_LOG_HMAC_KEY, e.g. a Docker
# secret (/run/secrets/...); set only one of both (both set stops the start).
# Default: none.
#AUDIT_LOG_HMAC_KEY_FILE=
# closed: an action whose event cannot be written (file, Redis) is refused or
# undone (503 audit_unavailable; a new secret is deleted again, a secret is not
# handed out, a sign-in is not completed). open: go on, report on stderr.
# Default: closed.
AUDIT_LOG_FAIL=
# Source address in events: full, hash (HMAC) or off. Default: full.
AUDIT_LOG_IP=
# Browser / client name in events. Default: true.
AUDIT_LOG_USER_AGENT=
# Name of this instance in the chain (one chain per instance); set a stable one
# per replica (StatefulSet name, systemd host) so a restart continues the same
# chain. Default: host name.
AUDIT_LOG_INSTANCE=
# Every n events an audit.checkpoint event with the current head hash, an
# anchor in the external copies (0: off). Default: 100.
AUDIT_LOG_CHECKPOINT=
# Forward to syslog (RFC 5424, facility authpriv): udp://host:514,
# tcp://host:514 or tls://host:6514; best effort with retries. Default: none.
AUDIT_LOG_SYSLOG=
# PEM file of the CA for tls://. Default: system CAs.
#AUDIT_LOG_SYSLOG_CA_FILE=
# Send to an OTLP/HTTP logs endpoint (JSON), e.g.
# http://otel-collector:4318/v1/logs. Default: none.
AUDIT_LOG_OTLP_URL=
# Extra headers, name=value,name=value (e.g. authorization=Bearer change-me).
# Default: none.
AUDIT_LOG_OTLP_HEADERS=
# Or a file whose first line is used as AUDIT_LOG_OTLP_HEADERS, e.g. a Docker
# secret (/run/secrets/...); set only one of both (both set stops the start).
# Default: none.
#AUDIT_LOG_OTLP_HEADERS_FILE=
# POST every event as JSON to this address. Default: none.
AUDIT_LOG_WEBHOOK_URL=
# Authorization header of the webhook, e.g. Bearer change-me or Splunk
# change-me. Default: none.
AUDIT_LOG_WEBHOOK_AUTH=
# Or a file whose first line is used as AUDIT_LOG_WEBHOOK_AUTH, e.g. a Docker
# secret (/run/secrets/...); set only one of both (both set stops the start).
# Default: none.
#AUDIT_LOG_WEBHOOK_AUTH_FILE=
# json (the event) or splunk (HTTP Event Collector envelope, batches). Default:
# json.
AUDIT_LOG_WEBHOOK_FORMAT=
# Comment field per secret (form and API, comment / X-Audit-Comment): off,
# optional or required. Needs AUDIT_LOG. It goes into the audit log and onto
# the status page, never into the secret. Default: off.
AUDIT_COMMENT=
# Most characters of a comment (10 to 2000). Default: 500.
AUDIT_COMMENT_MAX=

# --- API tokens and admins (need sign-in; docs/CONFIG.md#api-tokens)
# true: signed-in users make personal API tokens on the page "API tokens" (user
# menu). A token acts as its owner, is shown once and stored only as an HMAC.
# Default: false.
API_TOKENS=
# true: outside this server's own pages the API takes only these tokens: no
# anonymous calls, no session cookies from scripts, no other bearer tokens
# (AUTH_API_AUDIENCE). Default: false.
API_TOKEN_REQUIRED=
# Only these addresses / groups (as in the groups claim; Entra: object ids) may
# make tokens: the "activation" by the admins. Default: everyone signed in.
API_TOKEN_USERS=
API_TOKEN_GROUPS=
# required: every token must name the IP addresses or networks (IPv4/IPv6 CIDR)
# it works from; any other address is refused (403) and logged, which stops
# passing tokens on. Default: optional.
API_TOKEN_IP_BINDING=
# Lifetimes a user may pick: d days, w weeks, mo calendar months, y calendar
# years, never (m is minutes, too short for a token: 6m stops the start, write
# 6mo). Default: 30d,60d,90d,never.
API_TOKEN_EXPIRY_OPTIONS=
# Preselected lifetime; added to the choices if missing. Default: 90d (or the
# longest choice).
API_TOKEN_DEFAULT_EXPIRY=
# Longest lifetime allowed, e.g. 1y: longer choices and never disappear, the
# server refuses them. Default: never (no cap).
API_TOKEN_MAX_EXPIRY=
# Active tokens per user, 0 to 1000 (0: no limit). Only active tokens count;
# revoked and expired ones do not. At the limit the API tokens page shows "10
# of 10 active tokens" and a notice instead of the form, and the API refuses
# with 400 too_many_tokens (logged as api.token_create_denied, reason
# limit_reached). Default: 10.
API_TOKEN_MAX_PER_USER=
# Calls per token per RATE_LIMIT_WINDOW. Default: 0 (off).
API_TOKEN_RATE_LIMIT=
# required: every POST with a token needs a comment (X-Audit-Comment or
# comment); needs AUDIT_LOG. Default: optional.
API_TOKEN_COMMENT=
# What users may give their tokens: create (create secrets), read
# (retrieve/open them), status (status page), burn (destroy a secret by its
# receipt), or none. The form then offers only "only create", "only retrieve",
# "both" and the status and burn boxes as far as allowed. Default:
# create,read,status,burn.
API_TOKEN_ALLOWED_SCOPES=
# Preselected in the form and used when the API call names no scopes; must be
# within API_TOKEN_ALLOWED_SCOPES. Default: create,status,burn (within the allowed
# ones).
API_TOKEN_DEFAULT_SCOPES=
# Other scopes for the members of groups, wins over API_TOKEN_ALLOWED_SCOPES
# (several groups add up): <group>=<scopes>;..., e.g.
# /support=read;/it=create,read,status,burn (Entra: object ids). For GitOps.
# Default: none.
API_TOKEN_SCOPES_BY_GROUP=
# Admins set the scopes and the token limit per user and per group on /admin
# ("Token permissions", stored in Redis). Order: user > group >
# API_TOKEN_SCOPES_BY_GROUP > API_TOKEN_ALLOWED_SCOPES /
# API_TOKEN_MAX_PER_USER. Needs ADMIN_USERS or ADMIN_GROUPS and ADMIN_UI: unset
# it is off without them, an explicit true is an error. Default: true (with
# admins).
API_TOKEN_ADMIN_POLICY=
# The "Audit log" tab; needs AUDIT_LOG with AUDIT_LOG_FILE or
# AUDIT_LOG_REDIS=true. Default: true.
AUDIT_ADMIN_VIEW=
# The admin interface and the admin API at all (false: neither). Default: true.
ADMIN_UI=
# "My secrets" in the user menu (/secrets, GET /api/v1/me/secrets): every
# signed-in user sees the secrets they created and those for them or one of
# their groups, as the audit log knows them (metadata only, like the admins'
# Secrets tab). Only with sign-in; false: no entry, page and endpoint answer
# 404. true without AUDIT_LOG_REDIS=true is an error. Default: true (with
# AUDIT_LOG_REDIS=true).
MY_SECRETS=
# The refs on "My secrets" open the status page of the user's own secrets
# (/secrets/<ref>, GET /api/v1/me/secrets/{ref}): state, views and who opened
# them (RECEIPT_SHOW_VIEWER) as with the receipt link, without the link, and a
# burn button (ENABLE_BURN). Only for the creator, not for recipients. Admins
# get the same for every secret from the Secrets tab (/admin/secrets/<ref>,
# burn with ADMIN_BURN). Needs ENABLE_RECEIPTS and AUDIT_LOG_REDIS=true; false:
# plain refs, pages and endpoints answer 404. Default: true.
SECRET_DETAILS=
# Admins may burn any secret that is not yet opened, expired or burned ("Burn"
# in the Secrets tab, POST /api/v1/admin/secrets/{ref}/burn); needs ADMIN_UI,
# admins, ENABLE_BURN and AUDIT_LOG_REDIS=true: left empty it switches itself
# off without them, set to true without them the start stops. Default: true.
ADMIN_BURN=
# Technical users: API-only accounts (e.g. api_aap) that admins make on /admin
# and issue tokens for; they cannot sign in. Default: true.
API_SERVICE_ACCOUNTS=
# The scope admin for technical users' tokens: every admin function over the
# API. Only a signed-in admin can give it. Needs API_SERVICE_ACCOUNTS, admins
# and ADMIN_UI: unset it is off without them, an explicit true is an error.
# Default: true (with admins).
API_ADMIN_TOKENS=
# Admin tokens must name the IP networks they work from. Default: true.
API_ADMIN_TOKEN_REQUIRE_IP=
# Longest lifetime of an admin token (d, w, mo, y). Default: 90d.
API_ADMIN_TOKEN_MAX_EXPIRY=
# An admin token may issue further admin tokens (false: only a signed-in
# admin). Default: true.
API_ADMIN_TOKEN_CAN_ISSUE_ADMIN=
# Every admin API call with a token needs X-Audit-Comment (optional: not).
# Required.
API_ADMIN_COMMENT=
