# Vanishly settings with their defaults. Copy to .env (Docker Compose) or
# /etc/vanishly/vanishly.env (systemd) and change what you need; an empty
# value means the default. A wrong value or a misspelt name stops the start
# with a message. docs/CONFIG.md describes every setting.

# --- Server
# Public address, used for the links of POST /api/v1/share (empty: from the request).
BASE_URL=
# Listen address. Default 0.0.0.0; the systemd unit sets 127.0.0.1, a value
# here would override that.
#HOST=0.0.0.0
PORT=3000
# Reverse proxies in front: a number of hops (1), loopback, address ranges
# (10.0.0.0/8), or false when the app is reachable directly.
TRUST_PROXY=false
# Send Strict-Transport-Security (only when the site is served via HTTPS).
HSTS=false
# One line per request to stdout; ids are replaced by :id.
ACCESS_LOG=true

# --- Redis, e.g. redis://:change-me@redis:6379 with a password, an external
# one: rediss://app:change-me@redis.example.com:6380/0 (TLS, ACL user, db 0).
# Empty: redis://localhost:6379 (docker-compose/standalone: redis://redis:6379).
REDIS_URL=
# Or the URL from a file (Docker secret), and an own CA for rediss://.
REDIS_URL_FILE=
REDIS_TLS_CA_FILE=
REDIS_PREFIX=vanishly:

# --- Design and language
# default, aurora, example-brand, or a folder in TEMPLATES_DIR.
TEMPLATE=default
# Light or dark at the first visit: auto (the visitor's system setting),
# light or dark. Empty: the template's choice (defaultMode, usually auto).
# The light/dark button still lets each visitor switch (ENABLE_THEME_TOGGLE).
DEFAULT_MODE=
TEMPLATES_DIR=/var/lib/vanishly/templates
# Languages served, comma-separated (empty: all translations, en,de). One
# language (en) serves every page in it and hides the language link.
LANGUAGES=
# Used when the browser names none of LANGUAGES; one of them (empty: en).
DEFAULT_LANG=en
# Own translations (fr.json adds French, de.json replaces German texts).
TRANSLATIONS_DIR=/var/lib/vanishly/translations

# --- Expiry and views
# Entries of the expiry dropdown (m, h, d, w; or seconds), e.g. 15m,1h,1d,7d.
# Empty: 5m,1h,1d,3d,7d,14d,30d,90d up to MAX_TTL.
TTL_OPTIONS=
# Preselected entry, e.g. 1d (one of TTL_OPTIONS when that is set).
# Empty: 1 day, or the option closest to it.
DEFAULT_TTL=
# Longest expiry in seconds. Empty: 604800 (7 days), or the largest entry of TTL_OPTIONS.
MAX_TTL=
# Most views per secret (1-100).
MAX_VIEWS=10
# Seconds a receipt stays after its secret is gone.
RECEIPT_KEEP=604800

# --- Secret and passphrase rules
MAX_SECRET_CHARS=10000
# Shortest secret (1 = any) and passphrase (0 = any).
MIN_SECRET_CHARS=1
MIN_PASSPHRASE_LENGTH=0
# Character classes the passphrase must contain: any of upper,lower,digit,symbol, or all. Empty: none.
PASSPHRASE_COMPLEXITY=
# true: every secret needs a passphrase; unless-recipients: every secret
# without recipients (sign-in) needs one.
REQUIRE_PASSPHRASE=false
# Wrong passphrases before the secret is destroyed.
PASSPHRASE_ATTEMPTS=5

# --- Confirmation checkbox before "Create secret link"
# Without CONFIRM_TEXT_* the built-in text is used ("I confirm that this
# secret contains only one password: ..."). CONFIRM_TEXT sets both languages.
CONFIRM_CHECKBOX=false
CONFIRM_TEXT=
CONFIRM_TEXT_EN=
CONFIRM_TEXT_DE=

# --- "Generate" button
# Length (8-128) and character classes (upper,lower,digit,symbol or all);
# every chosen class appears at least once.
GENERATOR_LENGTH=20
GENERATOR_COMPLEXITY=all

# --- Rate limits per client IP and window (seconds); 0 switches one off
RATE_LIMIT_CREATE=30
RATE_LIMIT_READ=120
RATE_LIMIT_WINDOW=600

# --- API
# false: no public API; it then only answers this server's own pages.
ENABLE_API=true
# API reference (Scalar) at /api/docs.
ENABLE_API_DOCS=true
# "API" link in the footer.
ENABLE_API_LINK=true
# POST /api/v1/share (server-side encryption for scripts).
ENABLE_SHARE_API=true
# POST /api/v1/open: scripts open a secret link (with its passphrase) on the server.
ENABLE_OPEN_API=true
# GET /api/v1/secrets/{id}: a secret's state without using a view (the pages do not need it).
ENABLE_SECRET_META_API=true
# GET /api/v1/config: limits and options (for scripts; the pages do not need it).
ENABLE_CONFIG_API=true
# GET /api/v1/me: who is signed in (for scripts; the pages do not need it).
ENABLE_ME_API=true
# The endpoints the pages need; false: only this server's pages may call them.
# POST /api/v1/secrets (create).
ENABLE_CREATE_API=true
# POST /api/v1/secrets/{id}/reveal.
ENABLE_REVEAL_API=true
# GET /api/v1/receipts/{id} and .../burn.
ENABLE_RECEIPT_API=true
# GET /api and /api/v1 (index of the endpoints that are on).
ENABLE_API_INDEX=true

# --- Features (true = on, false = off)
# Passphrase field on the form.
ENABLE_PASSPHRASE=true
# Views dropdown; false: every secret can be opened once.
ENABLE_VIEWS=true
# Status page for the sender (receipt link); false also switches off the next three.
ENABLE_RECEIPTS=true
# "Burn now" button on the status page.
ENABLE_BURN=true
# Times of the views on the status page.
ENABLE_VIEW_LOG=true
# Share link again on the status page (the receipt link then carries the key).
ENABLE_RECEIPT_SHARE_LINK=true
# "Generate" button.
ENABLE_GENERATOR=true
# Language link in the header.
ENABLE_LANG_SWITCH=true
# Light/dark button in the header; false: the template's defaultMode or the system setting.
ENABLE_THEME_TOGGLE=true
# "Powered by Vanishly" link to GitHub in the footer.
ENABLE_GITHUB_LINK=true

# --- Sign-in and recipients (docs/CONFIG.md, docs/providers/README.md)
# none (default): no login. entra, a preset (keycloak, okta, auth0, google,
# ping, jumpcloud, cognito) or oidc: senders sign in and can choose who may
# open a secret. Needs BASE_URL. With none, leave the rest unset.
# Setup per provider: docs/providers/README.md
AUTH_PROVIDER=none
# Microsoft Entra ID (AUTH_PROVIDER=entra):
#ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
#ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
#ENTRA_CLIENT_SECRET=change-me
# Or the secret from a file (Docker secrets): ENTRA_CLIENT_SECRET_FILE=/run/secrets/entra
# Microsoft Graph with the application permission GroupMember.Read.All:
# group search (RECIPIENT_GROUPS=*), people search (RECIPIENT_USER_GROUP, also
# User.Read.All) and users in more than 200 groups.
#ENTRA_GRAPH=false
# National clouds only:
#ENTRA_AUTHORITY=https://login.microsoftonline.com
#ENTRA_GRAPH_URL=https://graph.microsoft.com
# The presets and any other OpenID Connect provider (AUTH_PROVIDER=oidc):
#OIDC_ISSUER=https://sso.example.com/realms/main
#OIDC_CLIENT_ID=vanishly
#OIDC_CLIENT_SECRET=change-me
#OIDC_SCOPES=openid profile email
# The ID token claim with the groups (presets know theirs; auth0: your Action's claim).
#OIDC_GROUPS_CLAIM=groups
# Only these e-mail domains sign in (required for google).
#AUTH_ALLOWED_DOMAINS=example.com
# Presets: people and group search in the provider's directory (read-only access,
# see docs/providers). Entra uses ENTRA_GRAPH instead.
#DIRECTORY_API=false
# keycloak, auth0, ping: a client of its own for the directory (default: the sign-in client).
#DIRECTORY_CLIENT_ID=vanishly-directory
#DIRECTORY_CLIENT_SECRET=change-me
# okta: API token; jumpcloud: API key (or DIRECTORY_API_TOKEN_FILE).
#DIRECTORY_API_TOKEN=change-me
# google: service account key file and the admin it acts for.
#DIRECTORY_GOOGLE_CREDENTIALS_FILE=/run/secrets/google_service_account.json
#DIRECTORY_GOOGLE_ADMIN=admin@example.com
# Where the directory API differs from the issuer (Auth0 custom domain, JumpCloud EU).
#DIRECTORY_URL=
# cognito: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or AWS_ROLE_ARN / AWS_WEB_IDENTITY_TOKEN_FILE.
# At least 32 random characters: openssl rand -base64 48 (or AUTH_SECRET_FILE).
# Changing it locks the open secrets that have recipients.
#AUTH_SECRET=change-me
# Seconds a sign-in lasts.
#AUTH_SESSION_TTL=28800
# Sign out also at the provider (provider; Entra default: local), so the next
# sign-in asks again. Needs <BASE_URL>/auth/logged-out as post logout redirect URI.
#AUTH_LOGOUT=provider
# Sign in automatically when the provider still knows the visitor (silent, once per tab).
#AUTH_AUTO_LOGIN=false
# Who may create secrets: signed-in or anyone.
#AUTH_CREATE=signed-in
# Recipients field: off, optional or required; most recipients per secret.
#RECIPIENTS=optional
#RECIPIENTS_MAX=10
# Groups to choose from: Name=<group id>,... (Entra: object id; otherwise the
# value of the groups claim), or * for a search over all groups (Entra with
# ENTRA_GRAPH=true; keycloak, okta, google, cognito with DIRECTORY_API=true).
#RECIPIENT_GROUPS=
# People search in the form: the group whose members are suggested while
# typing (Entra: object id; keycloak: /path; okta, ping, jumpcloud: group id;
# auth0: role id; google: group address; cognito: group name). Needs
# ENTRA_GRAPH=true or DIRECTORY_API=true. Empty: addresses only.
#RECIPIENT_USER_GROUP=
# Allowed e-mail domains of recipients, e.g. example.com,example.de (empty: any).
#RECIPIENT_DOMAINS=
# Accept bearer tokens on the API with this audience, e.g. api://<client id>.
#AUTH_API_AUDIENCE=
# Show on the status page who opened the secret (the signed-in name and address).
#RECEIPT_SHOW_VIEWER=false
# Responsible people/groups of a secret: off, optional or required.
#RESPONSIBLE=off
# Who sees the status page: link, or signed-in (creator, responsible, openers;
# the default with sign-in).
#STATUS_ACCESS=

# --- Audit log (docs/CONFIG.md#audit-log); off by default
# Who did what, when, for whom: one JSON event per line, hash-chained.
#AUDIT_LOG=false
# Field names: ecs (Elastic Common Schema), otel (OpenTelemetry) or plain.
#AUDIT_LOG_FORMAT=ecs
# Pretty-printed over several lines (development only).
#AUDIT_LOG_PRETTY=false
# Append-only file (a volume in containers); fsync every event.
#AUDIT_LOG_FILE=/var/log/vanishly/audit.jsonl
#AUDIT_LOG_FSYNC=true
# On stdout too (default: true when there is no file and no Redis stream).
#AUDIT_LOG_STDOUT=
# Into the Redis stream <prefix>audit (admin view across replicas); 0 = keep all.
#AUDIT_LOG_REDIS=false
#AUDIT_LOG_REDIS_MAXLEN=0
# Signs every event (HMAC); at least 32 characters, e.g. openssl rand -base64 48.
#AUDIT_LOG_HMAC_KEY=change-me
# Or from a file: AUDIT_LOG_HMAC_KEY_FILE=/run/secrets/audit_hmac_key
# closed: refuse or undo an action whose event cannot be written; open: go on.
#AUDIT_LOG_FAIL=closed
# Source address: full, hash or off; the browser name: true or false.
#AUDIT_LOG_IP=full
#AUDIT_LOG_USER_AGENT=true
# Name of this instance in the chain (default: host name); stable per replica.
#AUDIT_LOG_INSTANCE=
# A checkpoint event every n events (0 = off).
#AUDIT_LOG_CHECKPOINT=100
# Exporters, best effort: syslog (udp://, tcp://, tls://host:port), OTLP/HTTP, webhook.
#AUDIT_LOG_SYSLOG=tls://syslog.example.com:6514
#AUDIT_LOG_SYSLOG_CA_FILE=
#AUDIT_LOG_OTLP_URL=http://otel-collector:4318/v1/logs
# name=value,... (or AUDIT_LOG_OTLP_HEADERS_FILE)
#AUDIT_LOG_OTLP_HEADERS=
#AUDIT_LOG_WEBHOOK_URL=https://siem.example.com/ingest
# Authorization header, e.g. Bearer change-me or Splunk change-me (or _FILE).
#AUDIT_LOG_WEBHOOK_AUTH=
# json, or splunk (HTTP Event Collector envelope).
#AUDIT_LOG_WEBHOOK_FORMAT=json
# Comment per secret (what it is for): off, optional or required; most characters.
#AUDIT_COMMENT=off
#AUDIT_COMMENT_MAX=500

# --- API tokens and admins (need sign-in; docs/CONFIG.md#api-tokens)
# Personal API tokens on the page "API tokens" (user menu).
#API_TOKENS=false
# Outside the server's own pages the API takes only these tokens.
#API_TOKEN_REQUIRED=false
# Only these addresses / groups may make tokens (empty: everyone signed in).
#API_TOKEN_USERS=
#API_TOKEN_GROUPS=
# required: every token names the IP addresses/networks it works from.
#API_TOKEN_IP_BINDING=optional
# Lifetimes to pick: d days, m months, y years, never; default; cap (never = none).
#API_TOKEN_EXPIRY_OPTIONS=30d,60d,90d,never
#API_TOKEN_DEFAULT_EXPIRY=90d
#API_TOKEN_MAX_EXPIRY=never
# Active (not revoked, not expired) tokens per user (0 = no limit);
# calls per token per RATE_LIMIT_WINDOW (0 = off).
#API_TOKEN_MAX_PER_USER=10
#API_TOKEN_RATE_LIMIT=0
# What tokens may do: create, read (retrieve/open), status (status and burn), or none.
#API_TOKEN_ALLOWED_SCOPES=create,read,status
#API_TOKEN_DEFAULT_SCOPES=create,status
# Other scopes per group: <group>=<scopes>;... e.g. /support=read;/it=create,read,status
#API_TOKEN_SCOPES_BY_GROUP=
# Admins set scopes and token limits per user and group on /admin (in Redis).
#API_TOKEN_ADMIN_POLICY=false
# required: every POST with a token needs X-Audit-Comment (needs AUDIT_LOG).
#API_TOKEN_COMMENT=optional
# Admins: the whole admin interface (/admin) and the admin API. Groups as in
# the groups claim (Keycloak: /vanishly-admins; Entra: object id).
#ADMIN_USERS=
#ADMIN_GROUPS=
# The admin interface and admin API at all; its audit log tab.
#ADMIN_UI=true
#AUDIT_ADMIN_VIEW=true
# Technical users (API only, made by admins on /admin).
#API_SERVICE_ACCOUNTS=true
# The "admin" scope for technical users' tokens (the admin API by token):
# off by default; bound to IP networks, at most 90 days, may not issue further
# admin tokens, every call with a comment (X-Audit-Comment).
#API_ADMIN_TOKENS=false
#API_ADMIN_TOKEN_REQUIRE_IP=true
#API_ADMIN_TOKEN_MAX_EXPIRY=90d
#API_ADMIN_TOKEN_CAN_ISSUE_ADMIN=false
#API_ADMIN_COMMENT=required
