{
  "name": "vanishly",
  "version": "4.0.0",
  "private": true,
  "description": "Vanishly - share secrets with one-time links that burn after reading",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "tsc -p jsconfig.json",
    "test": "node --test --test-skip-pattern='^Redis refuses writes' tests/*.test.js && node --test --test-name-pattern='^Redis refuses writes' tests/api.test.js",
    "test:a11y": "node --test --test-concurrency=1 tests/a11y.e2e.js",
    "vendor": "node scripts/vendor.js",
    "audit:verify": "node src/audit-verify.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "8.7.5",
    "jose": "^6.2.18",
    "openid-client": "^6.9.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@scalar/api-reference": "^1.82.1",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
