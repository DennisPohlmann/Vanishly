{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to Vanishly are documented in this file.\nThe entries are generated by semantic-release from the Conventional Commits\n(https://www.conventionalcommits.org/); versions follow Semantic Versioning."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "echo ${nextRelease.version} > VERSION && npm version ${nextRelease.version} --no-git-tag-version --allow-same-version && sed -i -E 's/^version: .*/version: ${nextRelease.version}/; s/^appVersion: .*/appVersion: \"${nextRelease.version}\"/' charts/vanishly/Chart.yaml && clients/set-version.sh ${nextRelease.version}",
        "successCmd": "echo version=${nextRelease.version} >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "VERSION",
          "package.json",
          "package-lock.json",
          "charts/vanishly/Chart.yaml",
          "clients/python/pyproject.toml",
          "clients/python/src/vanishly/__init__.py",
          "clients/go/client.go",
          "clients/go/go.mod",
          "clients/go/cmd/vanishly/main.go",
          "clients/go/build.sh",
          "clients/go/README.md",
          "views/downloads.html",
          "docs/CLIENTS.md"
        ],
        "message": "chore(release): v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "draftRelease": true,
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
